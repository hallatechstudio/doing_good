DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_URL=http://localhost:5173
PORT=3001
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_FROM_EMAIL=
# Account token is only used by the optional configuration check script.
POSTMARK_ACCOUNT_TOKEN=

# Payment provider configuration. Checkout remains disabled until configured.
# Hosted checkout only needs a server-side secret. Paystack signs webhooks with the same key.
# Use a live secret for the configured held-payment provider.
PAYSTACK_SECRET_KEY=
PAYMENTS_ENABLED=false
# Set true only after the provider has approved the held-payment arrangement.
PAYMENT_HOLDING_APPROVED=false
# Local-only Paystack sandbox checkout. Never enable this in Render or Vercel.
LOCAL_PAYMENTS_ENABLED=false
# Existing account emails allowed to review disputes. Never exposed in frontend env.
# Create a normal account using this email and password, then list its email here.
# The password remains the account password; do not place it in frontend variables.
COMMERCE_ADMIN_EMAILS=admin@example.com
# Local/admin bootstrap only. Do not commit real values.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=DoingGood Administrator

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# On Render: NODE_ENV=production, APP_URL=https://doinggoodd.vercel.app, TRUST_PROXY=1
# Render provides PORT. Keep APP_URL=http://localhost:5173 for local development.
