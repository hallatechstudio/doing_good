DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_URL=http://localhost:5173
PORT=3001
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_FROM_EMAIL=
# Account token is only used by the optional configuration check script.
POSTMARK_ACCOUNT_TOKEN=

# Enable only after configuring Paystack. Membership is NGN 20,000 for 30 days, renewed manually.
PAYSTACK_SECRET_KEY=
PAYMENTS_ENABLED=false
# Sandbox order-flow switch only. Live paid checkout needs an approved holding provider.
PAYSTACK_HOLDING_APPROVED=false
# Existing account emails allowed to review disputes. Never exposed in frontend env.
COMMERCE_ADMIN_EMAILS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# On Render: NODE_ENV=production, APP_URL=https://doinggoodd.vercel.app, TRUST_PROXY=1
# Render provides PORT. Keep APP_URL=http://localhost:5173 for local development.
